# Kopie als .dev.vars anlegen (wird nicht eingecheckt) – nur fuer `npm run dev`.
# Beide optional: ohne sie wird das Passwort beim ersten Aufruf von /admin
# selbst vergeben und im lokalen KV abgelegt.
ADMIN_PASSWORD=""
SESSION_SECRET=""
SITE_URL="http://localhost:8788"

# Mailversand (optional, ohne diese Werte landen Anfragen nur im Admin-Bereich)
RESEND_API_KEY=""
CONTACT_FROM="Hundeschule <anfrage@deine-domain.de>"
CONTACT_TO=""

# Spamschutz (optional)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
