/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/photos/*
  Cache-Control: public, max-age=2592000

# Kurz halten und immer nachfragen: Sonst sehen wiederkehrende Besucher nach
# einer Änderung noch stundenlang die alte Gestaltung. Die Dateien sind klein,
# und unveränderte Inhalte beantwortet Cloudflare mit einem 304.
/assets/css/*
  Cache-Control: public, no-cache

/assets/js/*
  Cache-Control: public, no-cache

/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
